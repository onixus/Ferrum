{
  "schema": "ferrum.io/enforcement-event",
  "version": "1.1",
  "note": "Frozen field inventory. Not read by any binary and not a validator: it is the copy of the wire shape that a change to EventEnvelope has to be reconciled against, and crates/ferrum-testkit/tests/event_contract_gate.rs derives the other copy by serialising the type. `presence` is `always` (the key is on every record), `omitted` (the key disappears from its object) or `with-parent` (the key is required inside an object that is itself optional). Adding a field costs a minor bump and a new file beside this one; removing, renaming or retyping one is not an allowed change within a major version.",
  "fields": {
    "schema": { "type": "string", "presence": "always", "nullable": false },
    "schemaVersion": { "type": "string", "presence": "always", "nullable": false },
    "ts": { "type": "string", "presence": "always", "nullable": false },
    "node": { "type": "string", "presence": "always", "nullable": false },
    "bundleDigest": { "type": "string", "presence": "always", "nullable": true },
    "agentRole": { "type": "string", "presence": "always", "nullable": false },
    "degraded": { "type": "bool", "presence": "always", "nullable": false },
    "degradedReasons": { "type": "array", "presence": "always", "nullable": false },
    "event.policy": { "type": "string", "presence": "always", "nullable": false },
    "event.rule": { "type": "string", "presence": "always", "nullable": false },
    "event.action": { "type": "string", "presence": "always", "nullable": false },
    "event.imageDigest": { "type": "string", "presence": "always", "nullable": true },
    "event.pod": { "type": "string", "presence": "always", "nullable": false },
    "event.namespace": { "type": "string", "presence": "always", "nullable": false },
    "event.comm": { "type": "string", "presence": "always", "nullable": false },
    "event.syscall": { "type": "string", "presence": "always", "nullable": false },
    "event.pid": { "type": "number", "presence": "always", "nullable": false },
    "event.tgid": { "type": "number", "presence": "always", "nullable": false },
    "event.executed": { "type": "bool", "presence": "always", "nullable": false },
    "event.respondError": { "type": "string", "presence": "omitted", "nullable": false },
    "event.labelsUnknown": { "type": "bool", "presence": "always", "nullable": false },
    "event.pathUnknown": { "type": "bool", "presence": "always", "nullable": false },
    "event.containerUnknown": { "type": "bool", "presence": "always", "nullable": false },
    "event.waiver.ticket": { "type": "string", "presence": "with-parent", "nullable": false },
    "event.waiver.requestedBy": { "type": "string", "presence": "with-parent", "nullable": false },
    "event.waiver.approvedBy": { "type": "string", "presence": "with-parent", "nullable": false },
    "event.waiver.expiresAt": { "type": "string", "presence": "with-parent", "nullable": false }
  }
}
