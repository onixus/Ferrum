{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^1\\.0$(?![\\s\\S])",
      "title": "Schema Version",
      "type": "string"
    },
    "product_id": {
      "enum": [
        "shapoclyack",
        "lariska",
        "ferrum",
        "bsdm-proxy",
        "oko-ra",
        "pulse",
        "asmodeus"
      ],
      "title": "Product Id",
      "type": "string"
    },
    "deployment_mode": {
      "default": "docker",
      "enum": [
        "docker",
        "native",
        "kubernetes"
      ],
      "title": "Deployment Mode",
      "type": "string"
    },
    "installation_guide": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Installation Guide"
    },
    "compose_file": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compose File"
    },
    "required_environment": {
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$(?![\\s\\S])"
      },
      "title": "Required Environment",
      "type": "array"
    },
    "gateway_url_variable": {
      "default": "APEX_GATEWAY_URL",
      "title": "Gateway Url Variable",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$(?![\\s\\S])"
    },
    "service_url_variable": {
      "default": "APEX_SERVICE_URL",
      "title": "Service Url Variable",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$(?![\\s\\S])"
    },
    "health_service": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$(?![\\s\\S])",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Health Service"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "product_id"
  ],
  "title": "DeploymentManifest",
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [
          "deployment_mode"
        ],
        "properties": {
          "deployment_mode": {
            "enum": [
              "native",
              "kubernetes"
            ]
          }
        }
      },
      "then": {
        "required": [
          "installation_guide"
        ],
        "properties": {
          "installation_guide": {
            "type": "string"
          }
        }
      },
      "else": {
        "required": [
          "compose_file",
          "health_service"
        ],
        "properties": {
          "compose_file": {
            "type": "string"
          },
          "health_service": {
            "type": "string"
          }
        }
      }
    }
  ]
}
