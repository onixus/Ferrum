// Прогон тестов Ferrum на нативном amd64-агенте (Arch Linux, метка `gaming`).
//
// Зачем отдельный файл, а не метки в основном Jenkinsfile: тот собирает на
// mac-контроллере и завязан на его docker.sock и на SCM-путь /Users/onixus/Git/Ferrum,
// которого на ноде нет. Linux-ноды в режиме EXCLUSIVE, то есть `agent any`
// основного пайплайна туда не уедет даже случайно. Здесь всё наоборот: каждая
// стадия явно просит метку, и джоба `ferrum-linux` берёт исходники из bare-репо
// /home/onixus/Git/Ferrum.git на самой ноде — mac туда пушит.
//
// CARGO_TARGET_DIR на именованном томе: на ноде ext4 и гонки VirtioFS с потерей
// записей cargo структурно нет, но том держит кэш между прогонами, иначе каждая
// сборка холодная.
//
// Стадии образов сюда не портированы: они существуют ради docker CLI на ноде
// mac-пайплайна и к ядру отношения не имеют.

def RUST_IMAGE = 'rust:1-bookworm'
// Именованных томов здесь нет намеренно, в отличие от основного Jenkinsfile.
// Там они лечат VirtioFS: на mac bind-mount теряет записи cargo. На ноде ext4,
// этой болезни нет, а тома создаются от root — контейнер же docker-агент
// запускает под uid агента, и первый прогон умер на `Permission denied` при
// записи в /usr/local/cargo/registry. Кэш живёт в воркспейсе: он на ноде
// сохраняется между билдами и принадлежит тому же пользователю.
// Единственный том — bare-репо ноды, только на чтение. Шаги пайплайна идут
// внутри контейнера, а он монтирует лишь воркспейс: без этой строки `git fetch`
// не видел /home/onixus/Git/Ferrum.git и падал с "does not appear to be a git
// repository", хотя на самой ноде репозиторий на месте.
def RUST_DOCKER_ARGS = '-v /home/onixus/Git/Ferrum.git:/srv/ferrum.git:ro'
// Сборка ELF ставит nightly, LLVM и bpf-linker, то есть пишет за пределы
// воркспейса — под uid агента этого нельзя. Кэши у неё отдельные (.cargo-root-*)
// именно потому, что каталоги останутся за root, и мешать их с теми, что
// заполняет стадия тестов под своим uid, значит поломать вторую.
def ROOT_DOCKER_ARGS = RUST_DOCKER_ARGS + ' -u 0:0'
// То же, что DATAPATH_DOCKER_ARGS основного пайплайна, и по тем же причинам:
// два бита прав вместо --privileged, tracefs только на чтение, общий с ядром
// pid namespace — иначе bpf_get_current_pid_tgid() и getpid() дают разные числа
// и тест видит ноль своих записей при исправном датапейсе.
def DATAPATH_DOCKER_ARGS = ROOT_DOCKER_ARGS +
                           ' -v /sys/kernel/tracing:/sys/kernel/tracing:ro' +
                           ' --cap-add=BPF --cap-add=PERFMON --pid=host'
// Стык: тесты создают собственные cgroup, то есть пишут в cgroupfs.
//
// На маке это стоило отдельной группы с долгоживущим контейнером и remount'ом
// через привилегированный nsenter: Docker Desktop монтирует cgroupfs внутрь
// только на чтение. Здесь узел нативный, cgroup2 на нём уже rw, и достаточно
// смонтировать её как есть, отдав контейнеру хостовый cgroup namespace —
// иначе `/sys/fs/cgroup` внутри окажется поддеревом контейнера, а датапейс
// ключуется на идентификаторах из корня. CAP_SYS_ADMIN по-прежнему не даётся.
def JOIN_DOCKER_ARGS = DATAPATH_DOCKER_ARGS +
                       ' --cgroupns=host -v /sys/fs/cgroup:/sys/fs/cgroup:rw'
// Пины живут на bpffs, и монтирует её узел, а не контейнер: mount требует
// CAP_SYS_ADMIN, а этот контейнер исполняет код репозитория.
def PINS_DOCKER_ARGS = JOIN_DOCKER_ARGS +
                       ' -v /run/ferrum-bpffs:/run/ferrum-bpffs:rw'

pipeline {
    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        // Сборка BPF ELF на холодную ставит nightly, LLVM 23 и bpf-linker.
        timeout(time: 90, unit: 'MINUTES')
        // Джоба читает сам скрипт с mac-пути (lightweight checkout идёт на
        // контроллере), а дерево для сборки берётся уже на ноде — из её
        // собственного bare-репо. Неявный `checkout scm` в воркспейсе агента
        // пошёл бы по mac-пути, которого там нет, поэтому он выключен.
        skipDefaultCheckout()
    }

    environment {
        CARGO_TERM_COLOR = 'never'
    }

    stages {
        // Существует ради триггера, а не ради работы. Опрос SCM берёт источники
        // из последнего билда: без единого зарегистрированного источника джоба
        // не опрашивается вовсе ("Done. Took 0 ms / No changes") и не строится
        // сама никогда. Здесь checkout идёт по SCM джобы — mac-путь, который
        // контроллер видит, — и `agent any` остаётся на контроллере, потому что
        // linux-ноды в режиме EXCLUSIVE и берут только явную метку.
        stage('Триггер (контроллер)') {
            agent any
            steps {
                checkout scm
            }
        }

        stage('Test (linux/amd64)') {
            agent {
                docker {
                    image RUST_IMAGE
                    args RUST_DOCKER_ARGS
                    label 'gaming'
                    reuseNode false
                }
            }
            stages {
                stage('Toolchain') {
                    steps {
                        // Обычный `git` в sh, а не шаг `checkout`, и это
                        // единственное, что здесь работает. Опрос SCM исполняется
                        // на контроллере (git 2.47.3 из контейнера Jenkins против
                        // 2.55.0 на ноде), и любой зарегистрированный SCM с путём
                        // ноды он пытается опросить у себя: `ls-remote` падает с
                        // "does not appear to be a git repository", опрос
                        // прерывается целиком и джоба не строится вовсе. `poll:
                        // false` на шаге checkout этого не предотвратил —
                        // проверено, билд после правки так и не стартовал. Шаг sh
                        // Jenkins как источник не видит, поэтому триггером
                        // остаётся SCM самой джобы, то есть mac-путь.
                        sh '''
                            set -eu
                            git init -q .
                            git fetch -q --depth 1 /srv/ferrum.git main
                            git checkout -q -f FETCH_HEAD
                            git log --oneline -1
                        '''
                        sh '''
                            set -eu
                            export CARGO_HOME="$WORKSPACE/.cargo-home"
                            rustc -vV
                            cargo -V
                        '''
                    }
                }

                // Те же две строки, что и в основном Jenkinsfile: --workspace идёт
                // на дефолтных фичах, а каждая продовая фича в этом дереве по
                // умолчанию выключена, поэтому apiserver нужен отдельным прогоном.
                stage('cargo test') {
                    steps {
                        sh '''
                            set -eu
                            export CARGO_HOME="$WORKSPACE/.cargo-home"
                            export CARGO_TARGET_DIR="$WORKSPACE/.cargo-target"
                            cargo test --workspace
                            cargo test -p ferrum-admission --features apiserver
                        '''
                    }
                }
            }
        }

        // Ради чего нода вообще нужна. На mac-VM эта группа доходит до LSM и
        // молча не цепляет его; здесь ядро 7.2.3 с CONFIG_BPF_LSM=y, `bpf` в
        // /sys/kernel/security/lsm и vmlinux BTF, то есть предотвращение можно
        // проверить, а не пропустить.
        //
        // Стадии join/cgroup/pins основного пайплайна сюда не портированы: им
        // нужен remount cgroupfs изнутри mount namespace сборочного контейнера,
        // и это отдельная работа.
        stage('Датапейс (linux/amd64)') {
            agent { label 'gaming' }
            stages {
                // Исходники берутся здесь, на самой ноде, а не в контейнере:
                // группе нужен один воркспейс на две стадии, и bare-репо ноде
                // видно напрямую.
                stage('Дерево') {
                    steps {
                        sh '''
                            set -eu
                            git init -q .
                            git fetch -q --depth 1 /home/onixus/Git/Ferrum.git main
                            git checkout -q -f FETCH_HEAD
                            git log --oneline -1
                        '''
                    }
                }

                stage('BPF ELF') {
                    agent {
                        docker {
                            image RUST_IMAGE
                            args ROOT_DOCKER_ARGS
                            reuseNode true
                        }
                    }
                    steps {
                        sh '''
                            set -eu
                            export CARGO_HOME="$WORKSPACE/.cargo-root-home"
                            export RUSTUP_HOME="$WORKSPACE/.cargo-root-rustup"
                            export CARGO_TARGET_DIR="$WORKSPACE/.cargo-root-target"
                            export PATH="$CARGO_HOME/bin:$PATH"
                            rustup toolchain install nightly --profile minimal --component rust-src
                            if ! command -v bpf-linker >/dev/null 2>&1; then
                                # Та же сверка мажора LLVM, что в основном
                                # Jenkinsfile: расхождение — это ABI, по которому
                                # линкер сойдётся при сборке и разойдётся в работе.
                                llvm_major=23
                                have=$(rustc +nightly --version --verbose \
                                       | awk '/^LLVM version:/{split($3, v, "."); print v[1]}')
                                if [ "$have" != "$llvm_major" ]; then
                                    echo "nightly несёт LLVM $have, стадия ждёт $llvm_major" >&2
                                    exit 1
                                fi
                                # build.rs у bpf-linker ищет llvm-config, чтобы
                                # решить, какой llvm-sys-XX включить: без него
                                # стадия падает, ничего не собрав. Ключ пинится по
                                # отпечатку, а не «как отдал сервер»: иначе
                                # подменённый ключ подписал бы подменённый LLVM, и
                                # apt на это не пожалуется.
                                if ! command -v llvm-config >/dev/null 2>&1; then
                                    apt-get update
                                    apt-get install -y --no-install-recommends \
                                        curl gnupg ca-certificates
                                    curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
                                        -o /tmp/llvm.asc
                                    fpr=$(gpg --show-keys --with-colons /tmp/llvm.asc \
                                          | awk -F: '/^fpr/{print $10; exit}')
                                    if [ "$fpr" != 6084F3CF814B57C1CF12EFD515CF4D18AF4F7421 ]; then
                                        echo "ключ apt.llvm.org не тот: $fpr" >&2
                                        exit 1
                                    fi
                                    gpg --dearmor < /tmp/llvm.asc \
                                        > /usr/share/keyrings/ferrum-llvm.gpg
                                    echo "deb [signed-by=/usr/share/keyrings/ferrum-llvm.gpg]" \
                                         "https://apt.llvm.org/bookworm/" \
                                         "llvm-toolchain-bookworm-$llvm_major main" \
                                        > /etc/apt/sources.list.d/ferrum-llvm.list
                                    apt-get update
                                    apt-get install -y --no-install-recommends \
                                        "llvm-$llvm_major-dev"
                                    ln -sf "/usr/lib/llvm-$llvm_major/bin/llvm-config" \
                                        /usr/local/bin/llvm-config
                                fi
                                # Линковку берёт на себя рустец: образ не несёт
                                # простого libLLVM.so, поэтому версионный шимится,
                                # а сисрут едет на rpath.
                                sysroot="$(rustc +nightly --print sysroot)"
                                shim=/tmp/ferrum-llvm-shim
                                mkdir -p "$shim"
                                ln -sf "$sysroot"/lib/libLLVM-*.so "$shim/libLLVM.so"
                                RUSTFLAGS="-L $shim -L $sysroot/lib -C link-arg=-Wl,-rpath,$sysroot/lib" \
                                    cargo +nightly install bpf-linker --locked
                            fi
                            # bpf_loop требует BTF: колбэк обязан быть подпрограммой
                            # с func_info, иначе загрузка отвергается с "missing btf
                            # func_info" — сам верификатор при этом доволен, 208
                            # инструкций вместо миллиона. Релизная сборка BTF не
                            # несёт: нужны и отладочная информация, и --btf у
                            # bpf-linker, который иначе её не эмитит.
                            #
                            # Переменная именно target-специфичная. Обычный RUSTFLAGS
                            # достаётся и build.rs, а те собираются для хоста обычным
                            # cc: `cc: error: unrecognized command-line option
                            # '--btf'` уронил libc на первой же сборке скрипта.
                            export CARGO_TARGET_BPFEL_UNKNOWN_NONE_RUSTFLAGS="-C debuginfo=2 -C link-arg=--btf"
                            cargo +nightly build -p ferrum-ebpf-progs \
                                --target bpfel-unknown-none -Z build-std=core --release
                            elf="$CARGO_TARGET_DIR/bpfel-unknown-none/release/ferrum-ebpf-progs"
                            mkdir -p dist
                            cp "$elf" dist/ferrum-ebpf-progs.bpf.o
                        '''
                        archiveArtifacts artifacts: 'dist/ferrum-ebpf-progs.bpf.o', fingerprint: true
                    }
                }

                stage('BPF attach') {
                    agent {
                        docker {
                            image RUST_IMAGE
                            args DATAPATH_DOCKER_ARGS
                            reuseNode true
                        }
                    }
                    steps {
                        sh '''
                            set -eu
                            export CARGO_HOME="$WORKSPACE/.cargo-root-home"
                            export RUSTUP_HOME="$WORKSPACE/.cargo-root-rustup"
                            export CARGO_TARGET_DIR="$WORKSPACE/.cargo-root-target"
                            elf="$PWD/dist/ferrum-ebpf-progs.bpf.o"
                            test -f "$elf"
                            # Не конвейер: /bin/sh здесь dash, pipefail у него нет,
                            # и `| tee` отдал бы `set -e` статус tee, проглотив
                            # падение cargo test.
                            out=/tmp/ferrum-attach-live.out
                            if ! FERRUM_BPF_ELF_REQUIRED=1 FERRUM_BPF_ELF="$elf" \
                                cargo test -p ferrum-ebpf --features attach --test attach_live \
                                -- --show-output > "$out" 2>&1
                            then
                                cat "$out"
                                exit 1
                            fi
                            cat "$out"
                            # Положительный контроль из основного пайплайна: строка
                            # печатается только с той стороны состоявшегося attach,
                            # поэтому пропуск её выдать не может, сколько бы тестов
                            # он ни отчитал пройденными.
                            grep -q "attached through KernelHandle on " "$out"
                            cargo test -p ferrum-ebpf --features attach --lib
                        '''
                    }
                }
                stage('Стык cgroup') {
                    agent {
                        docker {
                            image RUST_IMAGE
                            args JOIN_DOCKER_ARGS
                            reuseNode true
                        }
                    }
                    steps {
                        sh '''
                            set -eu
                            # Проверка — настоящие mkdir/rmdir, а не `mount | grep rw`:
                            # «смонтировано rw» и «сюда можно писать» различает только
                            # попытка записи. Корень в mountinfo сверяется потому же,
                            # почему нужен --cgroupns=host: поддерево контейнера
                            # выглядело бы рабочим и давало бы чужие идентификаторы.
                            grep -qE " / /sys/fs/cgroup rw," /proc/self/mountinfo \
                                || { echo "cgroup2 не rw, либо его корень в mountinfo уже не /" >&2; exit 1; }
                            mkdir /sys/fs/cgroup/ferrum-cgroup-rw-probe
                            rmdir /sys/fs/cgroup/ferrum-cgroup-rw-probe
                            echo "ok: cgroup2 писабельна в контейнере датапейса, корень в mountinfo — /"
                        '''
                    }
                }

                stage('BPF join') {
                    agent {
                        docker {
                            image RUST_IMAGE
                            args JOIN_DOCKER_ARGS
                            reuseNode true
                        }
                    }
                    steps {
                        sh '''
                            set -eu
                            export CARGO_HOME="$WORKSPACE/.cargo-root-home"
                            export RUSTUP_HOME="$WORKSPACE/.cargo-root-rustup"
                            export CARGO_TARGET_DIR="$WORKSPACE/.cargo-root-target"
                            elf="$PWD/dist/ferrum-ebpf-progs.bpf.o"
                            test -f "$elf"
                            out=/tmp/ferrum-attach-join.out
                            if ! FERRUM_BPF_ELF_REQUIRED=1 FERRUM_BPF_ELF="$elf" \
                                cargo test -p ferrum-agent --features attach,apiserver \
                                --test attach_join -- --show-output > "$out" 2>&1
                            then
                                cat "$out"
                                exit 1
                            fi
                            cat "$out"
                            # Те же два гейта, что и на маке, и по той же причине:
                            # каждый пропуск в live() — ранний return из #[test], и
                            # счётчик passed у пустого прогона совпадает с настоящим
                            # символ в символ. Число берётся из исходника, а не
                            # записывается сюда, чтобы новый тест требовался этой
                            # стадией с момента, как он появился.
                            passed="$(sed -n 's/^test result: ok\\. \\([0-9][0-9]*\\) passed.*/\\1/p' "$out" | head -1)"
                            src=crates/ferrum-agent/tests/attach_join.rs
                            expected="$(sed -n '/^mod gate {/,$p' "$src" \
                                | grep -cE '^[[:space:]]*#\\[test\\][[:space:]]*$')"
                            if [ "${expected:-0}" -lt 1 ]; then
                                echo "в $src не нашлось ни одного #[test] под mod gate: стадия" >&2
                                echo "потеряла собственное представление о том, что обязана прогнать" >&2
                                exit 1
                            fi
                            if [ "${passed:-0}" -ne "$expected" ]; then
                                echo "BPF join прогнала ${passed:-0} из $expected тестов в $src" >&2
                                exit 1
                            fi
                            names=/tmp/ferrum-join-evidence.txt
                            anchor=crates/ferrum-agent/tests/join_evidence.rs
                            sed -n 's/^ *evidence: "\\(.*\\)",$/\\1/p' "$anchor" | sort -u > "$names"
                            if [ ! -s "$names" ]; then
                                echo "в $anchor не нашлось меток доказательства: требовать нечего" >&2
                                exit 1
                            fi
                            while read -r what; do
                                if ! grep -q "$what: kernel record" "$out"; then
                                    echo "BPF join отчиталась $passed пройденными без строки" >&2
                                    echo "доказательства для '$what' — она печатается только с" >&2
                                    echo "дальнего конца пути запись → вердикт → сигнал" >&2
                                    exit 1
                                fi
                            done < "$names"
                            echo "ok: все $passed join-тестов исполнились против этого ядра"
                            # Юнит-тесты агента под той парой фич, с которой едет
                            # DaemonSet: `cargo test --workspace` идёт на дефолтных,
                            # и обе выключены.
                            cargo test -p ferrum-agent --features attach,apiserver --lib
                        '''
                    }
                }

                // bpffs монтирует узел: mount требует CAP_SYS_ADMIN, которого
                // контейнеру с кодом репозитория не дают. Стадия без docker-агента,
                // то есть исполняется прямо на ноде.
                stage('bpffs на ноде') {
                    steps {
                        sh '''
                            set -eu
                            sudo -n mkdir -p /run/ferrum-bpffs
                            mountpoint -q /run/ferrum-bpffs \
                                || sudo -n mount -t bpf bpffs /run/ferrum-bpffs
                            mountpoint -q /run/ferrum-bpffs
                            sudo -n chmod 0777 /run/ferrum-bpffs
                            echo "ok: bpffs смонтирована на узле"
                        '''
                    }
                }

                stage('BPF pins') {
                    agent {
                        docker {
                            image RUST_IMAGE
                            args PINS_DOCKER_ARGS
                            reuseNode true
                        }
                    }
                    steps {
                        sh '''
                            set -eu
                            export CARGO_HOME="$WORKSPACE/.cargo-root-home"
                            export RUSTUP_HOME="$WORKSPACE/.cargo-root-rustup"
                            export CARGO_TARGET_DIR="$WORKSPACE/.cargo-root-target"
                            elf="$PWD/dist/ferrum-ebpf-progs.bpf.o"
                            test -f "$elf"
                            grep -q " - bpf bpffs " /proc/self/mountinfo \
                                || { echo "bpffs не смонтирована в контейнере датапейса" >&2; exit 1; }
                            out=/tmp/ferrum-attach-pins.out
                            if ! FERRUM_BPF_ELF_REQUIRED=1 FERRUM_BPF_ELF="$elf" \
                                FERRUM_BPF_PIN_ROOT=/run/ferrum-bpffs \
                                cargo test -p ferrum-ebpf --features attach \
                                --test attach_pins -- --show-output > "$out" 2>&1
                            then
                                cat "$out"
                                exit 1
                            fi
                            cat "$out"
                            # Строка печатается только после того, как пин переоткрыт
                            # при уже уничтоженном handle — с дальнего конца того
                            # единственного утверждения, ради которого стадия есть.
                            if ! grep -q "pins outlived the handle:" "$out"; then
                                echo "BPF pins прошла, не напечатав строку про переживший handle пин" >&2
                                exit 1
                            fi
                            if ! grep -q "^test result: ok[.] 3 passed" "$out"; then
                                echo "BPF pins прогнала не все три ядерных теста" >&2
                                exit 1
                            fi
                        '''
                    }
                }
            }
        }
    }
}
