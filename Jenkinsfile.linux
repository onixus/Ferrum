// Прогон тестов Ferrum на нативном amd64-агенте (Arch Linux, метка `gaming`).
//
// Зачем отдельный файл, а не метки в основном Jenkinsfile: тот собирает на
// mac-контроллере и завязан на его docker.sock и на SCM-путь /Users/onixus/Git/Ferrum,
// которого на ноде нет. Linux-ноды в режиме EXCLUSIVE, то есть `agent any`
// основного пайплайна туда не уедет даже случайно. Здесь всё наоборот: каждая
// стадия явно просит метку, и джоба `ferrum-linux` берёт исходники из bare-репо
// /home/onixus/Git/Ferrum.git на самой ноде — mac туда пушит.
//
// CARGO_TARGET_DIR на именованном томе: на ноде ext4 и гонки VirtioFS с потерей
// записей cargo структурно нет, но том держит кэш между прогонами, иначе каждая
// сборка холодная.
//
// Здесь только тесты. Стадии образов, BPF ELF и датапейс не портированы: они
// требуют tracefs, cap-add и сборки bpf-linker, и это отдельная работа.

def RUST_IMAGE = 'rust:1-bookworm'
// Именованных томов здесь нет намеренно, в отличие от основного Jenkinsfile.
// Там они лечат VirtioFS: на mac bind-mount теряет записи cargo. На ноде ext4,
// этой болезни нет, а тома создаются от root — контейнер же docker-агент
// запускает под uid агента, и первый прогон умер на `Permission denied` при
// записи в /usr/local/cargo/registry. Кэш живёт в воркспейсе: он на ноде
// сохраняется между билдами и принадлежит тому же пользователю.
def RUST_DOCKER_ARGS = ''

pipeline {
    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 60, unit: 'MINUTES')
        // Джоба читает сам скрипт с mac-пути (lightweight checkout идёт на
        // контроллере), а дерево для сборки берётся уже на ноде — из её
        // собственного bare-репо. Неявный `checkout scm` в воркспейсе агента
        // пошёл бы по mac-пути, которого там нет, поэтому он выключен.
        skipDefaultCheckout()
    }

    environment {
        CARGO_TERM_COLOR = 'never'
    }

    stages {
        stage('Test (linux/amd64)') {
            agent {
                docker {
                    image RUST_IMAGE
                    args RUST_DOCKER_ARGS
                    label 'gaming'
                    reuseNode false
                }
            }
            stages {
                stage('Toolchain') {
                    steps {
                        // poll: false обязателен. Опрос SCM исполняется на
                        // контроллере (в его логе git 2.47.3 — тот, что внутри
                        // контейнера Jenkins, а не 2.55.0 с ноды), и путь этого
                        // репозитория там не существует: поллинг падал с
                        // "does not appear to be a git repository" и билд #2 не
                        // стартовал вовсе. Триггером остаётся SCM джобы —
                        // mac-путь, который контроллер видит.
                        checkout(poll: false, changelog: true, scm: [$class: 'GitSCM',
                                 userRemoteConfigs: [[url: '/home/onixus/Git/Ferrum.git']],
                                 branches: [[name: '*/main']]])
                        sh '''
                            set -eu
                            export CARGO_HOME="$WORKSPACE/.cargo-home"
                            rustc -vV
                            cargo -V
                        '''
                    }
                }

                // Те же две строки, что и в основном Jenkinsfile: --workspace идёт
                // на дефолтных фичах, а каждая продовая фича в этом дереве по
                // умолчанию выключена, поэтому apiserver нужен отдельным прогоном.
                stage('cargo test') {
                    steps {
                        sh '''
                            set -eu
                            export CARGO_HOME="$WORKSPACE/.cargo-home"
                            export CARGO_TARGET_DIR="$WORKSPACE/.cargo-target"
                            cargo test --workspace
                            cargo test -p ferrum-admission --features apiserver
                        '''
                    }
                }
            }
        }
    }
}
