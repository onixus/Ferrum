{
  "contract": {
    "version": "1.0",
    "canonical_repo": "onixus/unified-platform",
    "canonical_commit": "878d138c560cd4106ab0d6cccde804ddc3e5ae1d"
  },
  "system": {
    "id": "ferrum",
    "namespace": "ferrum",
    "role": "k8s-enforcement"
  },
  "ownership": {
    "authoritative_domains": [
      "admission-policy",
      "runtime-enforcement",
      "policy-bundle",
      "break-glass-state"
    ],
    "gateway_is_source_of_truth": false,
    "clickhouse_is_transactional_source": false
  },
  "identity": {
    "accepts_apex_identity": true,
    "production_trusts_unsigned_role_header": false,
    "owning_service_authorizes_mutations": true
  },
  "resources": [
    {
      "kind": "policy",
      "local_id_field": "policy_id",
      "urn_prefix": "urn:apex:policy:ferrum:"
    },
    {
      "kind": "event",
      "local_id_field": "event_id",
      "urn_prefix": "urn:apex:event:ferrum:"
    },
    {
      "kind": "evidence",
      "local_id_field": "record_id",
      "urn_prefix": "urn:apex:evidence:ferrum:"
    }
  ],
  "integration": {
    "event_types": [
      "apex.ferrum.enforcement.v1"
    ],
    "produces": [
      "enforcement-event",
      "policy-decision",
      "runtime-evidence"
    ]
  },
  "observability": {
    "w3c_trace_context": true,
    "otel_resource_attribute": "apex.system",
    "apex_system_value": "ferrum"
  },
  "supply_chain": {
    "sbom_required": true,
    "sha256_required": true,
    "signature_required_for_production_promotion": true,
    "provenance_required_for_production_promotion": true
  }
}
